# Copy this file to .env and edit the values.

# Oracle schema created by sql/00_create_user.sql (or your lab user)
DB_USER=irrigation
DB_PASSWORD=irrigation123

# host:port/service_name
#   Oracle 21c XE    -> localhost:1521/XEPDB1
#   Oracle 23ai Free -> localhost:1521/FREEPDB1
#   Oracle 11g XE    -> localhost:1521/XE   (also set ORACLE_CLIENT_LIB below)
DB_DSN=localhost:1521/XEPDB1

# Only for Oracle 11g: folder of Oracle Instant Client (enables "thick" mode)
# ORACLE_CLIENT_LIB=C:\oracle\instantclient_21_13

# Any long random string; keeps login sessions secure
SECRET_KEY=change-me-to-a-long-random-string

PORT=5000
# FLASK_DEBUG=1
